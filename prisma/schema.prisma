// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// `url` is the POOLED connection (pgBouncer) that serverless functions use —
// without it every function instance opens its own pool and exhausts Postgres.
// `directUrl` is the unpooled connection, used only by `prisma migrate`, which
// runs DDL that pgBouncer's transaction mode cannot proxy. Locally both point
// at the same database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  workflows     Workflow[]
  credentials   Credential[]
  instagramCredentials InstagramCredential[]
  aiReplySettings      AiReplySettings?
  youtubeCredentials   YoutubeCredential[]
  youtubeCommentPolls  YoutubeCommentPoll[]
  gmailPolls           GmailPoll[]
  googleSheetsPolls    GoogleSheetsPoll[]
  schedulePolls        SchedulePoll[]
  webhookTriggers      WebhookTrigger[]
  googleCredential     GoogleCredential?
  microsoftCredential  MicrosoftCredential?
  conversations        Conversation[]
  notificationSettings NotificationSettings?

  @@unique([email])
  @@map("user")
}

model NotificationSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  notifyOnFailure Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Credential {
  id String @id @default(cuid())
  name String
  value String
  type CredentialType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  Node Node[]

  @@index([userId, updatedAt])
  @@index([userId, name])
  @@index([userId, type, updatedAt])
}

model InstagramCredential {
  id                   String    @id @default(cuid())
  userId               String
  accessToken          String
  instagramAccountId   String
  instagramUsername    String
  tokenExpiresAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiReplySettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  accountDescription String?
  replyTone          String?
  replyGoal          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model YoutubeCredential {
  id           String    @id @default(cuid())
  userId       String
  accessToken  String
  refreshToken String
  channelId    String
  channelTitle String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleCredential {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime?
  scopes       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MicrosoftCredential {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime?
  microsoftId  String
  displayName  String
  email        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model YoutubeCommentPoll {
  id          String   @id @default(cuid())
  userId      String
  workflowId  String
  videoId     String
  lastChecked DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, videoId])

  @@index([workflowId])
}

model GmailPoll {
  id          String   @id @default(cuid())
  userId      String
  workflowId  String   @unique
  lastChecked DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoogleSheetsPoll {
  id            String   @id @default(cuid())
  userId        String
  workflowId    String   @unique
  spreadsheetId String
  sheetName     String
  lastRowCount  Int      @default(0)
  // Last poll's edit snapshot: `{ sig, cols, header, headings, cellHashes }` —
  // `cellHashes` is one hash per watched cell per row (by position); `sig`/`cols`
  // are the name and index identities of the watched-column projection they were
  // computed under (see SheetsProjection), so a poll can tell if that projection
  // still holds; `header` is row 1 as last seen, so a poll can spot a renamed
  // column; `headings` is each merged heading's TEXT by row index, so a poll can
  // spot a retitled section. Null until the first poll seeds it; `{ sig, hashes }`
  // and a bare array are legacy shapes. Only consulted when the poll watches edits.
  rowHashes     Json?
  // Denormalized from the trigger node's `triggerOn`: "added" (append only,
  // the historical default), "updated" (edits only), or "added_or_updated".
  // Only consulted when rowScope admits data rows.
  triggerOn     String   @default("added")
  // Which KIND of row fires: "data" (skip merged heading rows), "headings" (fire
  // only when a heading's text changes), or "all" (no distinction). Defaults to
  // "all" — the behaviour before headings were understood here — so existing
  // polls are unchanged AND keep making a single API call ("data"/"headings" need
  // a second request for the tab's merged ranges).
  rowScope      String   @default("all")
  // Header (row-1) NAMES whose edits are IGNORED (the unchecked columns in the
  // dialog), resolved to indices at poll time so it survives reordering; the
  // poller rewrites a name that gets renamed in the sheet (healIgnoreColumns).
  // Null/empty ignores nothing — every column (incl. ones added later) is watched.
  ignoreColumns Json?
  lastChecked   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workflowId, spreadsheetId])
}

// Cron-driven trigger. One row per workflow that has a SCHEDULE_TRIGGER node,
// provisioned/cleaned by `syncTriggerPollsForWorkflow`. `pollSchedules` (a
// per-minute Inngest cron) scans for due rows via the `nextRunAt` index — an
// O(due) lookup, not O(all) — fans one event per row to `handleSchedulePoll`,
// which dispatches the workflow and advances `nextRunAt` to the next firing.
model SchedulePoll {
  id         String    @id @default(cuid())
  userId     String
  workflowId String    @unique
  // Standard 5-field cron expression (minute granularity), interpreted in `timezone`.
  cron       String
  // IANA timezone name (e.g. "America/New_York"); drives DST-correct firing.
  timezone   String
  // Next time this schedule is due to fire (UTC). Indexed for the due-row scan.
  nextRunAt  DateTime
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
}

// Inbound webhook credentials. One row per (workflow, trigger node type),
// provisioned/cleaned by `syncTriggerPollsForWorkflow`. `token` is the public,
// unguessable URL segment (cuid) used for O(1) lookup at
// `/api/webhooks/<provider>/<token>`; `secret` is encrypted at rest (cryptr)
// and used for the HMAC-SHA256 signature check on inbound requests.
model WebhookTrigger {
  id         String   @id @default(cuid())
  userId     String
  workflowId String
  token      String   @unique
  secret     String

  // Which trigger node this row belongs to, so one table serves every
  // token-authenticated webhook instead of one near-identical table per
  // provider.
  //
  // REQUIRED, with no default, and that is load-bearing. A default of
  // WEBHOOK_TRIGGER was needed exactly once — to label the rows predating this
  // column, which were all generic webhooks by construction — and the migration
  // that added it has run. Leaving it in place afterwards would let any
  // `create()` that forgets this field silently mint a GENERIC credential: a row
  // that then authenticates at `/api/webhooks/generic/<token>` and runs the
  // workflow with `initialData.webhook` where its nodes reference `googleForm`,
  // so every reference resolves blank and the run "succeeds". That is the exact
  // silent failure `authenticateTokenWebhook` scopes its WHERE clause to
  // prevent, and a column default would reopen it one layer down. A dropped
  // insert is a loud error; a mislabelled row is not.
  //
  // This is also what replaced `workflowId @unique` with a composite key. The
  // old single-column constraint quietly encoded "a workflow has at most one
  // webhook", which stopped being true the moment a second trigger type needed
  // a token — and would have let a Google Form and a generic webhook on the
  // same workflow collide on insert.
  nodeType NodeType

  // Whether an `X-Guideboard-Signature` HMAC is REQUIRED, or merely verified
  // when the caller chooses to send one.
  //
  // Defaults to false so this migration cannot break a live integration: every
  // row that already exists keeps the opt-in behaviour its caller was built
  // against. Newly provisioned triggers are created with `true`
  // (`syncTriggerPollsForWorkflow`), so the secure setting is what a new user
  // gets without choosing it, and the insecure one is what an existing user
  // keeps until they opt in.
  //
  // Signing matters here in a way it does not for the other webhooks: the
  // baseline credential is a token in the URL, and URLs leak — into proxy logs,
  // browser history, referrer headers, and screenshots — in a way a header
  // never does. A signature also binds the request to its BODY, so a captured
  // URL alone cannot be replayed with different content.
  requireSignature Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, nodeType])
}

enum CredentialType {
  OPENAI
  ANTHROPIC
  GEMINI
  INSTAGRAM
  NOTION
  TELEGRAM
  WHATSAPP
  XAI
  GROQ
  AFFINDA
  LEVER
  TYPEFORM
}

// Which engine executes a workflow's runs. See `Workflow.executionRuntime`.
//
// An ENUM rather than free text, and that is a safety property rather than
// tidiness: this single column decides which runtime executes a client's
// workflow, and it is set by hand during the migration. As `String?`,
// `SET "executionRuntime" = 'woker'` fell back to Inngest silently — which is
// indistinguishable from the routing switch not being deployed at all. As an
// enum, Postgres rejects the typo outright.
//
// `INNGEST` is spelled out even though NULL already means Inngest, so a
// workflow can be PINNED to it deliberately. That distinction is inert today
// and becomes load-bearing when the default flips to the worker: "never
// migrated" and "migrated, then rolled back, leave it alone" are different
// facts, and only one of them should move when the default changes.
enum ExecutionRuntime {
  INNGEST
  WORKER
}

model Workflow {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // True for a workflow whose graph exists but has never been through a save —
  // today, only a copy (see `duplicateWorkflow`). Its trigger poll rows are
  // deliberately not provisioned, so it is INERT until the user saves it, and
  // the editor opens it dirty ("Save", not "Saved") to make that state visible
  // and one click from fixed. Cleared by `workflows.update`.
  pendingFirstSave Boolean @default(false)

  // Which runtime executes this workflow's runs. NULL means Inngest — the
  // historical path, and the default for every row that predates the
  // self-hosted worker — so an unset column can never silently move a live
  // workflow onto new machinery.
  //
  // Read by `resolveExecutionRuntime` (src/inngest/utils.ts), which backs
  // `sendWorkflowExecution` — the single enqueue seam for every trigger,
  // poller, rerun and fan-out link. Nothing else reads it, and no application
  // code writes it: it is set by hand while workflows are migrated.
  //
  // ⚠️ ONE EXCEPTION to "the column decides", and it is a correctness one: a
  // fan-out chain already in flight ignores this column and finishes on the
  // runtime that started it (`FanOutChain.runtime`). The two runtimes enforce
  // "one run of a workflow at a time" through mechanisms that cannot see each
  // other — a partial unique index here, Inngest's `concurrency` key there — so
  // a chain split across both would run two items at once and shuffle the item
  // order the chain exists to preserve.
  //
  // Rolling a workflow back is one UPDATE to this column: both runtimes write
  // the same rows to the same tables, so there is nothing to migrate in either
  // direction. It stops NEW runs only — already-queued `WorkflowJob` rows are
  // still claimed, and DEPLOYMENT.md carries the full rollback runbook.
  //
  // Deliberately per-WORKFLOW rather than per-user or per-env: a workflow is
  // what a client owns and what has a known node mix, so it is the unit whose
  // blast radius can actually be reasoned about.
  executionRuntime ExecutionRuntime?

  nodes Node[]
  connections Connection[]
  executions Execution[]
  jobs WorkflowJob[]
  youtubeCommentPolls YoutubeCommentPoll[]
  gmailPolls GmailPoll[]
  googleSheetsPolls GoogleSheetsPoll[]
  schedulePolls SchedulePoll[]
  webhookTriggers WebhookTrigger[]
  conversations Conversation[]

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, name])
}

model Conversation {
  id         String   @id @default(cuid())
  userId     String
  workflowId String?
  messages   Json     @default("[]")
  phase      String   @default("GATHERING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
}

enum NodeType {
  INITIAL
  MANUAL_TRIGGER
  HTTP_REQUEST
  GOOGLE_FORM_TRIGGER
  TYPEFORM_TRIGGER
  GMAIL_TRIGGER
  GOOGLE_SHEETS_TRIGGER
  SCHEDULE_TRIGGER
  WEBHOOK_TRIGGER
  INSTAGRAM_COMMENT_TRIGGER
  INSTAGRAM_REPLY_COMMENT
  YOUTUBE_COMMENT_TRIGGER
  YOUTUBE_REPLY_COMMENT
  AI_REPLY_GENERATOR
  AI_TEXT
  ANTHROPIC
  CONDITION
  SWITCH
  RECORD_LOOKUP
  CONVERT
  CALCULATOR
  CODE
  GEMINI
  OPENAI
  DISCORD
  SLACK
  NOTION_ACTION
  TELEGRAM_ACTION
  TELEGRAM_TRIGGER
  WHATSAPP_ACTION
  GMAIL_ACTION
  GOOGLE_SHEETS_ACTION
  EXCEL_ACTION
  RESUME_PARSER
  CANDIDATE_SCORING
  ATS_ACTION
}

model Node {
  id String @id @default(cuid())
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name String
  type NodeType
  position Json
  data Json @default("{}")

  // Stable, human-readable reference key, unique within a workflow, e.g.
  // "AI_TEXT_1". Assigned once when the node is created and frozen thereafter,
  // so downstream `!#AI_TEXT_1.output#!` references never break. It IS the key
  // this node's output is written under in the run context. Nullable during the
  // backfill window; resolution falls back to `<type>_<id>` when absent.
  ref String?

  credentialId String?
  credential Credential? @relation(fields: [credentialId], references: [id])

  outputConnections Connection[] @relation("FromNode")
  inputConnections Connection[] @relation("ToNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowId, ref])
  @@index([workflowId])
}

model Connection {
  id String @id @default(cuid())
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode Node @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId String
  toNode Node @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  fromOutput String @default("main")
  toInput String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
  @@index([workflowId])
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum NodeExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Execution {
  id String @id @default(cuid())

  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status ExecutionStatus @default(RUNNING)
  error String? @db.Text
  errorStack String? @db.Text

  startedAt DateTime @default(now())
  completedAt DateTime?

  inngestEventId String @unique

  // Dedup key for the external event that started this run (`gmail:<messageId>`,
  // `google_sheets:<sheetId>:<row>:…`). Unique PER WORKFLOW, not globally: those
  // keys name an event, and two workflows watching the same inbox, sheet or
  // video legitimately both handle it. A global unique here meant whichever
  // poll landed first created the row and the other workflow's run was silently
  // dropped — trivially reachable by copying a workflow, and cross-tenant for a
  // shared source like a YouTube comment id. Nulls stay distinct in Postgres, so
  // the many runs without a key are unaffected.
  idempotencyKey String?

  // The trigger payload (initialData) this run started with, persisted so a run
  // can be re-dispatched verbatim via the `rerun` mutation. For a replay-from-node
  // run this is the seeded snapshot (the recorded input of the node replayed from).
  input Json?

  output Json?

  // Replay lineage: when this run is a "replay from node" of an earlier run, it
  // points at the origin execution (for observability / linking back). Null for
  // ordinary runs. SetNull so pruning an origin doesn't cascade-delete replays.
  replayOfId String?
  replayOf   Execution?  @relation("ExecutionReplays", fields: [replayOfId], references: [id], onDelete: SetNull)
  replays    Execution[] @relation("ExecutionReplays")

  nodeExecutions     NodeExecution[]
  fanOutSources      FanOutSource[]
  nodeInputSnapshots NodeInputSnapshot[]
  stepResults        StepResult[]

  @@unique([workflowId, idempotencyKey])
  @@index([workflowId, startedAt])
  @@index([workflowId, status, startedAt])
  @@index([replayOfId])
}

// The shared payload of one fan-out: the context every child run starts from,
// plus the item list children index into. Written ONCE by the parent run and
// read by each child, which is what keeps a chain link on the wire a
// fixed-size cursor (~200 bytes) no matter how many items there are.
//
// Chaining children to guarantee item order used to make each link carry the
// items still to do, so an N-item fan-out moved O(N^2) bytes and tipped onto
// blob storage at a few hundred rows. Storing the payload once makes it O(N).
//
// Postgres rather than R2 on purpose: blob storage is optional everywhere else
// in this codebase (every other caller degrades when it is unset), so making it
// the only overflow path turned an unconfigured bucket into a dead workflow.
// The database is already a hard dependency, and the cascade below means
// `pruneOldExecutions` drops these with their execution — no new GC wiring.
model FanOutSource {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  // The fan-out node, so two fan-out nodes in one run keep separate lists.
  nodeId String

  // The parent context MINUS the fan-out node's own summary output, which each
  // child overwrites with its per-item seed on arrival. See `carriedContext`.
  context Json

  items FanOutItem[]

  createdAt DateTime @default(now())

  @@unique([executionId, nodeId])
}

// One fan-out item. A row apiece, not one JSON array on FanOutSource, so a
// child reads ONLY its own item: with an array, every one of N children would
// transfer and parse the whole list, putting the O(N^2) term straight back —
// in the database instead of on the wire. The composite primary key is the
// lookup index.
model FanOutItem {
  sourceId String
  source   FanOutSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // 0-based cursor, matching `FanOutChain.index`.
  index Int
  item  Json

  @@id([sourceId, index])
}

// Per-node record of a single run. Node identity is denormalized (plain nodeId
// string + snapshot of type/name) rather than a FK to Node: nodes get edited or
// deleted while executions persist 30 days, and a cascade FK would erase
// history. Cascade from Execution means pruneOldExecutions cleans these up.
//
// This block used to say the opposite of the model below it — "intentionally NO
// @@unique([executionId, nodeId])" directly above a model that HAS that
// constraint (see it at the bottom, with its own correct explanation). Worth
// naming rather than deleting, because the claim it made was a spec: it said
// retry idempotency came from "stable per-node Inngest step ids". It does not,
// and increasingly will not. Idempotency has two independent sources now:
//
//   * the constraint below, which is what stops a retried segment accumulating
//     duplicate rows, and
//   * `StepResult` (keyed `(executionId, stepId)`), which is what stops a
//     completed step re-executing — the self-hosted runtime's replacement for
//     Inngest's step memoization, and the same guarantee whichever runtime runs.
//
// The loops caveat survives intact and is restated below: three tables now
// encode "a node runs at most once per execution", and a loops feature has to
// change all of them together.
model NodeExecution {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeType NodeType
  nodeName String
  sequence Int

  status     NodeExecutionStatus @default(RUNNING)
  input      Json?
  output     Json?
  // LEGACY. R2 key of the full (unclamped) input snapshot, back when blob
  // storage was the only place one could live. No longer written — full
  // snapshots go to `NodeInputSnapshot` — but still READ by `replayFromNode`
  // so rows written before the cutover stay replayable. Retention is 30 days,
  // so this column and its read path can be dropped a month after the change
  // ships; nothing will reference it by then.
  inputBlobKey String?
  error      String?             @db.Text
  errorStack String?             @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  // One row per node per execution — and the target of the recorder's upsert.
  // The recorder no longer writes inside its own `step.run` (that step cost ~4s
  // of Inngest dispatch latency per node, for a row nothing else waits on), so a
  // retried segment re-records the nodes it replays. Without this constraint
  // that would silently accumulate duplicate rows on every retry.
  //
  // Deliberately NOT keyed on `sequence`: a node runs at most once per
  // execution today, which is what makes (executionId, nodeId) the natural
  // identity. A future loops feature would have to add it here, to
  // `NodeInputSnapshot` (keyed on the same pair) AND to `StepResult`, whose
  // `(executionId, stepId)` key encodes the same assumption one layer down —
  // and whose violation is the silent one, since a second pass through a node
  // would be served the first pass's stored values instead of executing.
  @@unique([executionId, nodeId])
  @@index([executionId, sequence])
  // On-demand canvas failure lookup: latest FAILED run for a given node
  // (executions.getLatestNodeFailure) filters by nodeId, so it needs its own
  // index — the composite above is keyed on executionId and can't serve it.
  @@index([nodeId])
}

// The full, unclamped input a node received, kept so `replayFromNode` can seed a
// replay with real data. Written only when `NodeExecution.input` had to be
// replaced by a `clampJson` truncation marker — replaying FROM a marker is
// silently destructive (every `@<REF.path>@` renders blank while each node still
// performs its real side effect), so the choice is a true snapshot or an honest
// refusal.
//
// A SEPARATE TABLE rather than a column on NodeExecution, and that is the whole
// design: the execution detail page loads node rows with `include: {}`, which
// selects every scalar column. A wide `input` column there is exactly what the
// 32 KB clamp exists to prevent, so re-adding the payload as a sibling column
// would reintroduce the cost the clamp was paying to avoid. Here it is read
// only by the one query that replays.
//
// Postgres rather than R2 (which this replaces) for the reason `FanOutSource`
// gives: blob storage is optional everywhere else in this codebase, so making
// it the only home for a snapshot meant an unconfigured bucket silently and
// permanently destroyed the ability to replay. The database is not optional.
model NodeInputSnapshot {
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  // Keyed to match `NodeExecution`'s own identity, so the snapshot is found by
  // primary key from the same pair the replay already has.
  nodeId String

  input Json

  createdAt DateTime @default(now())

  @@id([executionId, nodeId])
}

// ─── Self-hosted execution runtime ──────────────────────────────────────────
//
// The queue and the durable-step store that let a long-lived worker process run
// workflows without Inngest. Both are inert until `Workflow.executionRuntime` is
// set; see plans/PART1-QUEUE-AND-WORKER.md for the full design.

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// One queued workflow run. Replaces the Inngest event as the thing that says
// "this workflow should execute, with this payload".
//
// ⚠️ The per-workflow concurrency guarantee is NOT in this file. It is a PARTIAL
// UNIQUE INDEX — `("workflowId") WHERE status = 'RUNNING'` — added by hand in the
// migration that creates this model, because Prisma's DSL cannot express a
// partial index and will not drift-detect it. It is what replaces Inngest's
// `concurrency: { key: "event.data.workflowId", limit: 1 }`, and it has to be a
// row constraint rather than an advisory lock: `pg_advisory_lock` is
// session-scoped, and PgBouncer in transaction mode hands the session to another
// client between statements, so on Neon's pooled endpoint a session lock is
// neither reliably held nor releasable.
model WorkflowJob {
  id String @id @default(cuid())

  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Exactly `SendWorkflowExecutionInput` minus workflowId — initialData,
  // initialDataSnapshot, idempotencyKey, replayFromNodeId, replayOfExecutionId,
  // fanOutChain. One JSON column on purpose: the enqueue seam's shape IS the
  // queue's shape, so the two cannot drift as that input type grows.
  payload Json

  // Mirrors `Execution.idempotencyKey`. An OPTIMIZATION only — it drops a
  // duplicate before it costs a claim. The actual guarantee remains Execution's
  // own @@unique([workflowId, idempotencyKey]), which the worker re-checks
  // before creating anything, and which survives this row being pruned.
  idempotencyKey String?

  status JobStatus @default(PENDING)

  // When this job becomes claimable. Carries both retry backoff and any future
  // delayed scheduling.
  runAt DateTime @default(now())

  // Incremented on CLAIM, not on failure, so a job that reliably kills its
  // worker (an OOM, a native crash) still terminates instead of looping.
  attempt Int @default(0)

  // Lease losses — a reclaim after the worker died, was fenced, or was
  // redeployed mid-run. Counted SEPARATELY from `attempt` because they are
  // infrastructure noise, not failures: a rolling deploy would otherwise burn a
  // real attempt. The first `MAX_FREE_RECLAIMS` refund the attempt they cost;
  // past that they stop refunding, which is what preserves the poison-job
  // property above. Also the number that says the worker host is unhealthy,
  // which nothing else surfaces.
  reclaims Int @default(0)

  maxAttempts Int

  // Lease, not a held transaction: a run can take minutes, and holding a
  // transaction open that long against a pooled endpoint is not viable. The
  // worker claims in a short transaction, then heartbeats `leaseExpiresAt`.
  // A heartbeat that updates ZERO rows means this worker has been fenced and
  // must abort at the next step boundary — without that, reclaim runs one
  // execution on two workers and double-writes a client's spreadsheet.
  lockedBy String?
  leaseExpiresAt DateTime?

  // Set once the run's row exists, so a failure BEFORE that point still has
  // somewhere to be recorded. Inngest's onFailure updates by `inngestEventId`
  // and therefore cannot report a pre-row failure at all.
  executionId String? @unique

  lastError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowId, idempotencyKey])
  @@index([status, runAt])
  @@index([workflowId, status])
  // For `readQueueGauges`' `failedInWindow`, which counts FAILED jobs whose
  // `updatedAt` falls inside a rolling window. Without it that aggregate reads
  // EVERY failed row and filters in the heap — and FAILED is the one status the
  // gauge query does not exclude, bounded only by retention (`pruneWorkflowJobs`
  // deletes FAILED at 29 days), so it accumulates far past what is queued now.
  // That same index serves the retention DELETE's own status/updatedAt predicate.
  //
  // ⚠️ Not micro-optimization: a long-lived worker runs that query every 60
  // seconds forever, on the deliberately tiny control-plane pool the heartbeat
  // depends on. An O(all failures ever) scan there is how a metrics line
  // becomes the thing that starves the fence.
  @@index([status, updatedAt])
}

// One memoized `step.run` / `step.ai.wrap` result — the durable-step store that
// replaces Inngest's memoization. A completed step never executes twice, which
// is what keeps a resumed run from re-sending an email or re-appending a row.
//
// This is load-bearing for correctness, not performance. Google Sheets writes
// split a plan step from a write step precisely so the plan can be replayed
// instead of re-derived: re-reading `nextFreeSheetRow` after the write landed
// points one row lower and appends a DUPLICATE. See CHECKPOINTED_NODE_TYPES in
// src/config/node-kinds.ts.
//
// Cascades from Execution, so `pruneOldExecutions` already collects these with
// no new GC wiring — the same property NodeInputSnapshot and FanOutSource have.
model StepResult {
  executionId String
  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  // "<nodeId>:<the executor's own step id>[#n]".
  //
  // ⚠️ The `nodeId` prefix is REQUIRED, not tidiness. Executors use fixed literal
  // step ids — "get-credential" appears in four AI executors, and "http-request",
  // "condition", "switch", "slack-webhook" are each a single literal — so two
  // nodes of the same type in one workflow collide on the bare id, and the second
  // would be served the first's stored value. That is a wrong-result bug which
  // looks exactly like memoization working.
  //
  // Inngest masks this today by auto-indexing collisions per RUN, in execution
  // order (see its AUTOMATIC_PARALLEL_INDEXING warning). Keying by NODE instead
  // is deliberately different and strictly more stable: an id here does not
  // renumber when an unrelated node using the same literal is added upstream.
  // The optional `#n` suffix handles a single node calling one id twice.
  stepId String

  // The JSON round-tripped return value. Round-tripped on the WRITE path too,
  // not only on read: Inngest's step.run returns `Jsonify<T>`, so a Date is
  // already a string by the time an executor sees it. Returning the raw value on
  // first execution and a parsed one on resume would make behaviour differ only
  // after a crash — green in every test, wrong only in production.
  value Json

  createdAt DateTime @default(now())

  // ⚠️ NO iteration counter, so this encodes "a node runs at most once per
  // execution" — the same constraint NodeExecution and NodeInputSnapshot carry
  // (see the note on NodeExecution's @@unique). A Tier 2 loops feature must add
  // `sequence` to ALL THREE, and this is the dangerous member of the set: the
  // other two produce a visibly wrong row, while a memoized step in iteration 2
  // would SILENTLY return iteration 1's value.
  @@id([executionId, stepId])
}
