# Core app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
ENCRYPTION_KEY="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Email (Resend) — used for password-reset emails
RESEND_API_KEY="re_your_resend_api_key"
# Sender address. Defaults to Resend's sandbox (onboarding@resend.dev), which can
# only deliver to the email that owns the Resend account. Use a verified-domain
# address for real delivery, e.g. "Guideboard <noreply@yourdomain.com>".
EMAIL_FROM="Guideboard <onboarding@resend.dev>"

# OAuth providers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Inngest
INNGEST_APP_ID="workflow-automation-app"

# Google Form webhook (shared secret — pass via x-webhook-secret header or ?secret= query param)
GOOGLE_FORM_WEBHOOK_SECRET="your-random-secret-here"

# Typeform webhooks (form Connect → Webhooks — same secret in Typeform and here; signs typeform-signature)
TYPEFORM_WEBHOOK_SECRET="your-typeform-webhook-secret-here"

# Telegram Bot webhooks (setWebhook secret_token — must match X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret-here"

# Instagram OAuth (Basic Display / Graph)
INSTAGRAM_APP_ID="your_instagram_app_id_here"
INSTAGRAM_APP_SECRET="your_instagram_app_secret_here"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"
INSTAGRAM_VERIFY_TOKEN="your_random_verify_token_here"

# YouTube webhooks (PubSubHubbub)
YOUTUBE_VERIFY_TOKEN="your_random_youtube_verify_token_here"
YOUTUBE_WEBHOOK_SECRET="your_random_youtube_webhook_secret_here"

# YouTube OAuth (Google Cloud Console → Credentials → OAuth 2.0)
YOUTUBE_CLIENT_ID="your_youtube_client_id_here"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret_here"
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/auth/youtube/callback"

# Dev helpers
NGROK_URL="https://your-ngrok-domain.ngrok-free.app"


GEMINI_API_KEY="your-Gemini-Key" 
GEMINI_MODEL="Gemini-Model"
ANTHROPIC_API_KEY ="your-Claude-Key"

# Sentry (error tracking + structured logging)
# Leave the DSN unset locally — with no DSN the whole layer is a no-op and the
# logger falls back to console.*. Set these only in production.
SENTRY_DSN="https://your-key@oXXXX.ingest.sentry.io/XXXX"
# Same DSN, exposed to the browser SDK (must be NEXT_PUBLIC_* to be readable client-side).
NEXT_PUBLIC_SENTRY_DSN="https://your-key@oXXXX.ingest.sentry.io/XXXX"
# Sampling — keep low so volume never becomes a cost cliff (defaults to 0.1).
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Source-map upload (org/project/token) runs only in CI; local builds skip it.
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"
SENTRY_AUTH_TOKEN="sntrys_your_ci_only_auth_token"
