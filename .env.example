# Core app
# DATABASE_URL is the POOLED connection the app runs on; DIRECT_URL is the
# unpooled one `prisma migrate` needs for DDL (pgBouncer's transaction mode
# cannot proxy it). Both are REQUIRED — `prisma generate` runs on postinstall
# and fails with P1012 if either is missing. Locally, point them at the same
# database; only a pooled production host makes them differ.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
ENCRYPTION_KEY="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Email (Resend) — used for password-reset emails
RESEND_API_KEY="re_your_resend_api_key"
# Sender address. Defaults to Resend's sandbox (onboarding@resend.dev), which can
# only deliver to the email that owns the Resend account. Use a verified-domain
# address for real delivery, e.g. "Guideboard <noreply@yourdomain.com>".
EMAIL_FROM="Guideboard <onboarding@resend.dev>"

# OAuth providers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Inngest
INNGEST_APP_ID="workflow-automation-app"
# REQUIRED IN PRODUCTION. /api/inngest is the endpoint that dispatches workflow
# runs, and the SDK verifies each incoming request's signature against this key.
# Copy it from the Inngest dashboard (Settings -> Signing key). Leave it unset
# in local dev, where the Inngest dev server does not sign requests.
# The app refuses to boot in production without it — see
# src/lib/production-config.ts.
# INNGEST_SIGNING_KEY="signkey-prod-..."
# How many times a failed workflow run is retried. Defaults to 3 in production
# and 1 in dev — one retry is enough to ride out a transient network fault (a
# dropped socket, a TLS handshake alert) without masking a genuinely broken
# node. Set to 0 while reproducing a real bug, when you want failures immediate.
# INNGEST_RETRIES="1"
# How often the schedule poller looks for due SCHEDULE_TRIGGER workflows.
# Defaults to every minute, which is what minute-grained crons need. The tick is
# billed whether or not anything is due, so a deployment with coarse schedules —
# or none at all — should set "*/5 * * * *" and cut ~35k executions a month.
# Caps granularity: a schedule fires only as precisely as the poll that finds it.
SCHEDULE_POLL_CRON="* * * * *"
# How many polls of one provider may run at once. Inngest validates this against
# the account's plan ceiling when the app syncs and REFUSES to register a
# function declaring more, so this must not exceed the plan's concurrency limit
# (Hobby allows 5, which is the default). Raise it on a paid plan.
POLL_CONCURRENCY="5"

# Self-hosted worker (npm run worker:dev) — the alternative execution runtime.
# A long-lived process that claims WorkflowJob rows from Postgres and runs them,
# instead of Inngest. Routing EXISTS now (sendWorkflowExecution reads
# Workflow.executionRuntime), but every workflow's column is NULL and NULL means
# Inngest — so these stay inert until a row is deliberately flipped to 'WORKER'.
# See DEPLOYMENT.md, "Moving a workflow between runtimes", for the flip and the
# rollback runbook.
#
# ⚠️ It needs DATABASE_URL and ENCRYPTION_KEY and REFUSES TO START without real
# values for both (src/worker/config.ts). It does NOT need BETTER_AUTH_SECRET or
# INNGEST_SIGNING_KEY — it serves no HTTP and signs no cookies. But it DECRYPTS
# every stored third-party API key and OAuth token it touches, so its host and
# its image are production-secret-bearing and must be treated as such.
#
# ⚠️ THREE MORE ARE NOT ASSERTED AND THE WORKER DEGRADES SILENTLY WITHOUT EACH.
# Nothing crashes; it just quietly stops doing things you would assume it does:
#   NODE_ENV=production  — without it Sentry initialises DISABLED and logger.error
#                          skips captureException, so every worker error is
#                          console-only. It ALSO halves the retry budget, since
#                          enqueueWorkflowJob's maxAttempts comes from
#                          resolveWorkflowRetries(), which reads NODE_ENV.
#   RESEND_API_KEY       — without it a failed run is marked FAILED and the owner
#                          is NEVER TOLD: sendEmail throws and the throw is
#                          caught and logged (which, per the above, is invisible).
#   BETTER_AUTH_URL      — without it the failure email's link is malformed.
#
# Identifies this worker in WorkflowJob.lockedBy. Leave unset: the default is
# hostname-pid-random, and the random suffix is load-bearing — a container that
# restarts with the same hostname would otherwise inherit the dead worker's
# identity while its jobs are still leased to it.
# WORKER_ID=""
# How many runs one worker executes at once. Defaults to 4, which the pool
# budget below is derived from. Only buys throughput ACROSS workflows: one
# RUNNING job per workflow is a correctness guarantee fan-out ordering needs.
# WORKER_CONCURRENCY="4"
# The worker wants its OWN connection string — same database, but
# ?connection_limit=10&pool_timeout=20 appended, and NO pgbouncer=true. It opens
# a second, tiny pool (connection_limit=2) for its heartbeat automatically, so
# that a saturated execution pool can never stop it renewing its lease.

# Google Form webhook (shared secret — pass via x-webhook-secret header or ?secret= query param)
GOOGLE_FORM_WEBHOOK_SECRET="your-random-secret-here"

# Typeform webhooks (form Connect → Webhooks — same secret in Typeform and here; signs typeform-signature)
TYPEFORM_WEBHOOK_SECRET="your-typeform-webhook-secret-here"

# Telegram Bot webhooks (setWebhook secret_token — must match X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret-here"

# Instagram OAuth (Basic Display / Graph)
INSTAGRAM_APP_ID="your_instagram_app_id_here"
INSTAGRAM_APP_SECRET="your_instagram_app_secret_here"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"
INSTAGRAM_VERIFY_TOKEN="your_random_verify_token_here"

# YouTube webhooks (PubSubHubbub)
YOUTUBE_VERIFY_TOKEN="your_random_youtube_verify_token_here"
YOUTUBE_WEBHOOK_SECRET="your_random_youtube_webhook_secret_here"

# YouTube OAuth (Google Cloud Console → Credentials → OAuth 2.0)
YOUTUBE_CLIENT_ID="your_youtube_client_id_here"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret_here"
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/auth/youtube/callback"

# Microsoft OAuth (Azure Portal → App registrations; multitenant org accounts).
# Powers the Excel node (OneDrive for Business via Microsoft Graph). Work/school
# accounts only — the Graph Excel workbook APIs don't support personal OneDrive.
MICROSOFT_CLIENT_ID="your_microsoft_application_client_id_here"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret_here"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"

# Blob storage (Cloudflare R2, S3-compatible) — stores binary conversion outputs
# (images, PDFs, audio/video) so they travel through the workflow as URLs, not
# base64. Leave unset locally: text-only conversions work without it; binary
# conversions throw a clear "not configured" error until these are set.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket-name"
# Optional public bucket / custom domain base URL (e.g. https://cdn.yourdomain.com).
# When unset, putBlob returns a time-limited signed URL instead.
R2_PUBLIC_BASE_URL="https://your-public-bucket-domain"

# CloudConvert — runs the Convert node's binary conversions (images, PDF,
# audio/video). Platform-owned key (you hold the account and bill users). Leave
# unset locally: text conversions work without it; binary ones throw a clear
# "not configured" error until this is set. Requires R2 (above) to store output.
CLOUDCONVERT_API_KEY="your-cloudconvert-api-key"

# Dev helpers
NGROK_URL="https://your-ngrok-domain.ngrok-free.app"


GEMINI_API_KEY="your-Gemini-Key"
GEMINI_MODEL="Gemini-Model"
ANTHROPIC_API_KEY="your-Claude-Key"

# Sentry (error tracking + structured logging)
# Leave the DSN unset locally — with no DSN the whole layer is a no-op and the
# logger falls back to console.*. Set these only in production.
SENTRY_DSN="https://your-key@oXXXX.ingest.sentry.io/XXXX"
# Same DSN, exposed to the browser SDK (must be NEXT_PUBLIC_* to be readable client-side).
NEXT_PUBLIC_SENTRY_DSN="https://your-key@oXXXX.ingest.sentry.io/XXXX"
# Sampling — keep low so volume never becomes a cost cliff (defaults to 0.1).
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Source-map upload (org/project/token) runs only in CI; local builds skip it.
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"
SENTRY_AUTH_TOKEN="sntrys_your_ci_only_auth_token"
